{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "opaque_packet_id",
    "source_packet_sha256",
    "scorer_id",
    "score",
    "committed_at",
    "score_commitment_sha256",
    "arm_guess",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "opaque_packet_id": {
      "type": "string"
    },
    "source_packet_sha256": {
      "$ref": "#/$defs/sha"
    },
    "scorer_id": {
      "type": "string",
      "pattern": "^scorer-[a-z0-9-]+$"
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria",
        "total_0_10",
        "missing_evidence",
        "evidence_references",
        "rationale"
      ],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        },
        "total_0_10": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "missing_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "committed_at": {
      "type": "string",
      "format": "date-time"
    },
    "score_commitment_sha256": {
      "$ref": "#/$defs/sha"
    },
    "arm_guess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recorded_at",
        "guess",
        "confidence"
      ],
      "properties": {
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "guess": {
          "enum": [
            "control",
            "treatment",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "record_sha256": {
      "$ref": "#/$defs/sha"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
