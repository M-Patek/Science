{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable self-bootstrap attempt bundle v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cohort_id",
    "cell_id",
    "arm",
    "attempt_id",
    "attempt_ordinal",
    "freeze_sha256",
    "allocation_ledger_sha256",
    "packet_set_sha256",
    "subject_packet_sha256",
    "baseline",
    "identities",
    "local_evidence",
    "timing",
    "task_evidence_started",
    "evidence_manifest",
    "stop_reason",
    "censor",
    "deviations",
    "critical_violations",
    "finalized_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "cohort_id": {
      "const": "self-bootstrap-effectiveness-v2"
    },
    "cell_id": {
      "type": "string"
    },
    "arm": {
      "enum": [
        "control",
        "treatment"
      ]
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"
    },
    "attempt_ordinal": {
      "const": 1
    },
    "freeze_sha256": {
      "$ref": "#/$defs/sha"
    },
    "allocation_ledger_sha256": {
      "$ref": "#/$defs/sha"
    },
    "packet_set_sha256": {
      "$ref": "#/$defs/sha"
    },
    "subject_packet_sha256": {
      "$ref": "#/$defs/sha"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "git_tree"
      ],
      "properties": {
        "git_commit": {
          "$ref": "#/$defs/git"
        },
        "git_tree": {
          "$ref": "#/$defs/git"
        }
      }
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned_session_id",
        "planned_worktree_id",
        "planned_context_id",
        "native_agent_id",
        "observed_harness_session_id",
        "observed_cwd",
        "observed_head_commit",
        "observed_head_tree"
      ],
      "properties": {
        "planned_session_id": {
          "type": "string"
        },
        "planned_worktree_id": {
          "type": "string"
        },
        "planned_context_id": {
          "type": "string"
        },
        "native_agent_id": {
          "type": "string"
        },
        "observed_harness_session_id": {
          "type": "string"
        },
        "observed_cwd": {
          "type": "string"
        },
        "observed_head_commit": {
          "$ref": "#/$defs/git"
        },
        "observed_head_tree": {
          "$ref": "#/$defs/git"
        }
      }
    },
    "local_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_level",
        "harness_receipt_sha256",
        "local_dispatch_acceptance_sha256",
        "execution_gate_sha256"
      ],
      "properties": {
        "evidence_level": {
          "const": "host-observed-unsigned"
        },
        "harness_receipt_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        },
        "local_dispatch_acceptance_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_gate_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bootstrap_started_utc",
        "task_received_utc",
        "ended_utc",
        "bootstrap_elapsed_seconds",
        "task_elapsed_seconds"
      ],
      "properties": {
        "bootstrap_started_utc": {
          "type": "string",
          "format": "date-time"
        },
        "task_received_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ended_utc": {
          "type": "string",
          "format": "date-time"
        },
        "bootstrap_elapsed_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "task_elapsed_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 5400
        }
      }
    },
    "task_evidence_started": {
      "type": "boolean"
    },
    "evidence_manifest": {
      "type": "object"
    },
    "stop_reason": {
      "enum": [
        "completed",
        "timeout",
        "context-exhaustion",
        "explicit-block",
        "critical-violation",
        "infrastructure-failure",
        "refusal",
        "test-failure"
      ]
    },
    "censor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-censored",
            "setup-censored"
          ]
        },
        "reason": {
          "enum": [
            null,
            "wrong-frozen-material",
            "nonfresh-workspace-or-context",
            "duplicate-identity",
            "prohibited-registration-leakage",
            "host-capture-failure",
            "pre-task-infrastructure-failure"
          ]
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "critical_violations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "fabricated-evidence-or-approval",
          "raw-or-completed-record-rewrite",
          "scope-or-worktree-escape",
          "secret-or-private-data-exposure",
          "unauthorized-resource-use",
          "cross-cell-messaging"
        ]
      }
    },
    "finalized_sha256": {
      "$ref": "#/$defs/sha"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
