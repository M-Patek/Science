{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cohort_id",
    "freeze_sha256",
    "seed_sha256",
    "algorithm",
    "wave_size",
    "wave_count",
    "baseline",
    "baseline_material_sha256",
    "cell_count",
    "entries",
    "ledger_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "cohort_id": {
      "const": "self-bootstrap-effectiveness-v2"
    },
    "freeze_sha256": {
      "$ref": "#/$defs/sha"
    },
    "seed_sha256": {
      "$ref": "#/$defs/sha"
    },
    "algorithm": {
      "const": "sha256-ranked-cells-v1"
    },
    "wave_size": {
      "const": 3
    },
    "wave_count": {
      "const": 8
    },
    "cell_count": {
      "const": 24
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "git_tree"
      ],
      "properties": {
        "git_commit": {
          "$ref": "#/$defs/git"
        },
        "git_tree": {
          "$ref": "#/$defs/git"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cell_id",
          "fixture_id",
          "block",
          "arm",
          "rank_sha256",
          "execution_order",
          "wave",
          "arm_policy_sha256",
          "arm_policy_path",
          "tools",
          "write_scope"
        ],
        "properties": {
          "cell_id": {
            "type": "string"
          },
          "fixture_id": {
            "type": "string"
          },
          "block": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "arm": {
            "enum": [
              "control",
              "treatment"
            ]
          },
          "rank_sha256": {
            "$ref": "#/$defs/sha"
          },
          "execution_order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          },
          "wave": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "arm_policy_sha256": {
            "$ref": "#/$defs/sha"
          },
          "arm_policy_path": {
            "type": "string",
            "pattern": "^experiments/self-bootstrap-effectiveness-v2/templates/arm-(control|treatment)-v2\\.yaml$"
          },
          "tools": {
            "type": "object",
            "minProperties": 1
          },
          "write_scope": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "ledger_sha256": {
      "$ref": "#/$defs/sha"
    },
    "baseline_material_sha256": {
      "$ref": "#/$defs/sha"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
